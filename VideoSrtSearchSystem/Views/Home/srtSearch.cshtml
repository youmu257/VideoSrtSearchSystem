@using Share.DTO.Response.Srt
@using Share.DTO.Response.Video
@{
    // https://bbbootstrap.com/snippets/bootstrap-search-box-input-icons-inside-88211241
    List<SearchSrtVideoResponse> VideoList = ViewData["VideoList"] as List<SearchSrtVideoResponse>;
    string keyword = ViewData["Keyword"] as string;
    string startDate = ViewData["Start"] as string;
    string endDate = ViewData["End"] as string;
    int page = ViewData["Page"] == null ? 1 : (int)ViewData["Page"];
    int totalPage = ViewData["TotalPage"] == null ? 1 : (int)ViewData["TotalPage"];
}
<div class="container">
    <div class="row height d-flex justify-content-center align-items-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <div class="search mb-3">
                        <i class="fa fa-search"></i>
                        <input type="text" id="searchQuery" class="form-control" placeholder="查詢關鍵字" value="@keyword">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="startDate" class="form-label">開始時間</label>
                            <input type="date" id="startDate" class="form-control" value="@startDate">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="endDate" class="form-label">結束時間</label>
                            <input type="date" id="endDate" class="form-control" value="@endDate">
                        </div>
                    </div>
                    <div class="text-center">
                        <button class="btn btn-primary" onclick="redirectToSearchResults()">搜尋</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @if (VideoList != null && VideoList.Count() > 0)
    {
        <div class="row mt-4">
            <div class="col-md-12">
                <div id="searchResults">
                    @foreach (var item in VideoList)
                    {
                        var collapseId = "collapse_" + item.VideoGuid;
                        <p>
                            <a class="btn btn-primary" data-bs-toggle="collapse" href="#@collapseId" role="button" aria-expanded="false" aria-controls="@collapseId">
                                [@item.LiveTime] @item.VideoTitle
                            </a>
                        </p>
                        <div class="collapse" id="@collapseId">
                            <div class="list-group">
                                @foreach (var srtObj in item.SrtList)
                                {
                                    var url = $"https://www.youtube.com/watch?v={item.VideoUrl}&t={srtObj.SrtStartTimeSeconds.ToString()}s";
                                    <div class="list-group-item">
                                        <a class="mb-1" href="@url" target="_blank">@srtObj.SrtStartTime - @srtObj.SrtEndTime</a>
                                        <p class="mb-1">@srtObj.Context</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    <nav aria-label="Page navigation" class="pagination-wrapper mt-3">
        <ul class="pagination">
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link pagination-link" href="#" data-page="@(page - 1)" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
            @for (int i = 1; i <= totalPage; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link pagination-link" href="#" data-page="@i">
                        @i
                    </a>
                </li>
            }
            <li class="page-item @(page >= totalPage ? "disabled" : "")">
                <a class="page-link pagination-link" href="#" data-page="@(page + 1)" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>
<script type="text/javascript">
    function redirectToSearchResults(pageNumber) {
        var query = document.getElementById("searchQuery").value;
        var startDate = document.getElementById("startDate").value;
        var endDate = document.getElementById("endDate").value;

        var encodedQuery = encodeURIComponent(query);

        // 構建URL參數
        var params = 'keyword=' + encodedQuery;
        if (startDate) {
            params += '&start=' + encodeURIComponent(startDate);
        }
        if (endDate) {
            params += '&end=' + encodeURIComponent(endDate);
        }

        // 如果提供了頁碼，將其添加到URL，否則使用預設值1
        var pageParam = pageNumber ? '&page=' + pageNumber : '';

        window.location.href = 'srtSearch?' + params + pageParam;
    }

    // 為分頁連結添加事件監聽器
    document.addEventListener('DOMContentLoaded', function() {
        var paginationLinks = document.querySelectorAll('.pagination-link');
        paginationLinks.forEach(function(link) {
            link.addEventListener('click', function(e) {
                e.preventDefault(); // 阻止預設行為
                var page = this.getAttribute('data-page');
                redirectToSearchResults(page);
            });
        });
    });
</script>