@using Share.DTO.Response.Srt
@using Share.DTO.Response.Video
@{
    // 字幕搜尋頁面 - 用於搜尋影片中的字幕內容
    // 參考樣式來源: https://bbbootstrap.com/snippets/bootstrap-search-box-input-icons-inside-88211241
    
    // 從 ViewData 取得搜尋結果與參數
    List<SearchSrtVideoResponse> VideoList = ViewData["VideoList"] as List<SearchSrtVideoResponse>;
    string keyword = ViewData["Keyword"] as string ?? string.Empty;
    string startDate = ViewData["Start"] as string ?? string.Empty;
    string endDate = ViewData["End"] as string ?? string.Empty;
    int page = ViewData["Page"] as int? ?? 1;
    int totalPage = ViewData["TotalPage"] as int? ?? 1;
}
<div class="container">
    <!-- 搜尋表單區塊 -->
    <div class="row height d-flex justify-content-center align-items-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <!-- 關鍵字搜尋輸入框 -->
                    <div class="search mb-3">
                        <i class="fa fa-search"></i>
                        <input type="text" 
                               id="searchQuery" 
                               class="form-control" 
                               placeholder="查詢關鍵字" 
                               value="@keyword"
                               aria-label="搜尋關鍵字">
                    </div>
                    
                    <!-- 日期範圍選擇器 -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="startDate" class="form-label">開始時間</label>
                            <input type="date" 
                                   id="startDate" 
                                   class="form-control" 
                                   value="@startDate"
                                   aria-label="開始日期">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="endDate" class="form-label">結束時間</label>
                            <input type="date" 
                                   id="endDate" 
                                   class="form-control" 
                                   value="@endDate"
                                   aria-label="結束日期">
                        </div>
                    </div>
                    
                    <!-- 搜尋按鈕 -->
                    <div class="text-center">
                        <button class="btn btn-primary" 
                                onclick="redirectToSearchResults()" 
                                aria-label="執行搜尋">
                            搜尋
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @if (VideoList != null && VideoList.Any())
    {
        <!-- 搜尋結果顯示區域 -->
        <div class="row mt-4">
            <div class="col-md-12">
                <div id="searchResults">
                    @foreach (var item in VideoList)
                    {
                        // 為每個影片生成唯一的折疊面板 ID
                        var collapseId = $"collapse_{item.VideoGuid}";
                        
                        <!-- 影片標題按鈕 (可點擊展開/收合字幕列表) -->
                        <p>
                            <a class="btn btn-primary" 
                               data-bs-toggle="collapse" 
                               href="#@collapseId" 
                               role="button" 
                               aria-expanded="false" 
                               aria-controls="@collapseId"
                               title="點擊展開字幕列表">
                                [@item.LiveTime] @item.VideoTitle
                            </a>
                        </p>
                        
                        <!-- 字幕列表折疊面板 -->
                        <div class="collapse" id="@collapseId">
                            <div class="list-group">
                                @foreach (var srtObj in item.SrtList)
                                {
                                    // 組合 YouTube 影片 URL，包含時間戳記參數
                                    var url = $"https://www.youtube.com/watch?v={item.VideoUrl}&t={srtObj.SrtStartTimeSeconds}s";
                                    
                                    <!-- 單一字幕項目 -->
                                    <div class="list-group-item">
                                        <a class="mb-1" 
                                           href="@url" 
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           title="開啟 YouTube 影片並跳轉到此時間點">
                                            @srtObj.SrtStartTime - @srtObj.SrtEndTime
                                        </a>
                                        <p class="mb-1">@srtObj.Context</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    <!-- 分頁導航列 -->
    <nav aria-label="頁面導航" class="pagination-wrapper mt-3">
        <ul class="pagination">
            <!-- 上一頁按鈕 -->
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link pagination-link" 
                   href="#" 
                   data-page="@(page - 1)" 
                   aria-label="上一頁"
                   title="上一頁">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
            
            <!-- 頁碼按鈕 -->
            @for (int i = 1; i <= totalPage; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link pagination-link" 
                       href="#" 
                       data-page="@i"
                       aria-label="第 @i 頁"
                       title="跳轉到第 @i 頁">
                        @i
                    </a>
                </li>
            }
            
            <!-- 下一頁按鈕 -->
            <li class="page-item @(page >= totalPage ? "disabled" : "")">
                <a class="page-link pagination-link" 
                   href="#" 
                   data-page="@(page + 1)" 
                   aria-label="下一頁"
                   title="下一頁">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>
<script type="text/javascript">
    /**
     * 重導向到搜尋結果頁面
     * 收集搜尋參數並重導向到搜尋頁面
     * pageNumber - 頁碼（選填，預設為 1）
     */
    function redirectToSearchResults(pageNumber) {
        // 取得表單輸入值
        const query = document.getElementById("searchQuery").value.trim();
        const startDate = document.getElementById("startDate").value;
        const endDate = document.getElementById("endDate").value;

        // 建構 URL 查詢參數
        const params = new URLSearchParams();
        
        // 關鍵字參數（必要）
        if (query) {
            params.append('keyword', query);
        }
        
        // 日期範圍參數（選填）
        if (startDate) {
            params.append('start', startDate);
        }
        if (endDate) {
            params.append('end', endDate);
        }
        
        // 頁碼參數（選填，未提供時使用預設值）
        if (pageNumber) {
            params.append('page', pageNumber);
        }

        // 重導向到搜尋頁面
        window.location.href = 'srtSearch?' + params.toString();
    }

    /**
     * DOM 載入完成後初始化事件監聽器
     */
    document.addEventListener('DOMContentLoaded', function() {
        // 為所有分頁連結添加點擊事件
        const paginationLinks = document.querySelectorAll('.pagination-link');
        paginationLinks.forEach(function(link) {
            link.addEventListener('click', function(e) {
                e.preventDefault(); // 阻止預設的錨點跳轉行為
                
                const pageNumber = this.getAttribute('data-page');
                
                // 確保頁碼有效後才執行重導向
                if (pageNumber && pageNumber > 0) {
                    redirectToSearchResults(pageNumber);
                }
            });
        });

        // 為搜尋輸入框添加 Enter 鍵事件監聽器
        const searchInput = document.getElementById("searchQuery");
        if (searchInput) {
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    redirectToSearchResults();
                }
            });
        }
    });
</script>