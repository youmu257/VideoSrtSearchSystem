@using Share.DTO.Response.Tag
@{
    var tagTypeList = ViewData["TagTypeList"] as List<TagTypeResponse>;
}

<div class="container">
    <h2>Add Tag</h2>

    <!-- 下拉式選單 -->
    <div class="col-md-4 mb-3">
        <label for="typeSelect" class="form-label">標籤類型</label>
        <select id="typeSelect" name="type" class="form-select">
            <option value="">請選擇類型</option>
            @foreach (var type in tagTypeList)
            {
                <option value="@type.Id">@type.TypeName</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label>標籤名稱</label>
        <input type="text" id="tagName" class="form-control">
    </div>

    <button onclick="redirectToSearchResults()" class="btn btn-primary">新增</button>
    <a href="/addTag" class="btn btn-secondary">Cancel</a>
</div>
<script type="text/javascript">
    function redirectToSearchResults(pageNumber) {
        var tagName = document.getElementById("tagName").value;
        var tagType = document.getElementById("typeSelect").value;

        // 構建URL參數
        window.location.href = 'insertTag?type=' + encodeURIComponent(tagType) + "&name=" + encodeURIComponent(tagName);
    }
</script>