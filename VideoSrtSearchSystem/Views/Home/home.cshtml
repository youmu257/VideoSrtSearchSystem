@using Share.DTO.Response.Tag
@using Share.DTO.Response.Video
@{
    // 影片搜尋主頁 - 用於搜尋和瀏覽影片列表
    ViewData["Title"] = "影片查詢主頁";
    
    // 從 ViewData 取得影片列表和搜尋參數
    var items = ViewData.ContainsKey("VideoList") 
        ? ViewData["VideoList"] as List<VideoResponse> 
        : new List<VideoResponse>();
    string keyword = ViewData["Keyword"] as string ?? string.Empty;
    int page = ViewData["Page"] as int? ?? 1;
    int totalPage = ViewData["TotalPage"] as int? ?? 1;
}

<div class="container mt-4">
    <!-- 搜尋輸入區域 -->
    <div class="row d-flex justify-content-center align-items-center mb-4">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <div class="search">
                        <i class="fa fa-search"></i>
                        <input type="text" 
                               id="searchQuery" 
                               class="form-control" 
                               placeholder="請輸入影片標題關鍵字" 
                               value="@keyword"
                               aria-label="搜尋影片關鍵字">
                        <button class="btn btn-primary" 
                                onclick="redirectToSearchResults()"
                                aria-label="搜尋">
                            <i class="fa fa-search"></i> 搜尋
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- 影片列表顯示區域 -->
    @if (items != null && items.Any())
    {
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">影片列表 (共 @items.Count 筆)</h5>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var item in items)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="flex-grow-1">
                            <strong class="text-primary">@item.VideoTitle</strong>
                            <br />
                            <small class="text-muted">
                                <a href="https://www.youtube.com/watch?v=@item.VideoUrl" 
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   title="在 YouTube 上觀看"
                                   aria-label="在 YouTube 上觀看 @item.VideoTitle">
                                    <i class="fa fa-external-link"></i> @item.VideoUrl
                                </a>
                            </small>
                        </div>
                        <div>
                            <a href="edit?guid=@item.VideoGuid" 
                               class="btn btn-primary btn-sm"
                               title="編輯影片資訊"
                               aria-label="編輯 @item.VideoTitle">
                                <i class="fa fa-edit"></i> 編輯
                            </a>
                        </div>
                    </li>
                }
            </ul>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center" role="alert">
            <i class="fa fa-info-circle"></i> 沒有找到符合條件的影片。
        </div>
    }
    <!-- 分頁導航列 -->
    <nav aria-label="頁面導航" class="pagination-wrapper mt-3">
        <ul class="pagination justify-content-center">
            <!-- 上一頁按鈕 -->
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link pagination-link" 
                   href="#" 
                   data-page="@(page - 1)" 
                   aria-label="上一頁"
                   title="上一頁">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
            
            <!-- 頁碼按鈕 -->
            @for (int i = 1; i <= totalPage; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link pagination-link" 
                       href="#" 
                       data-page="@i"
                       aria-label="第 @i 頁"
                       title="跳轉到第 @i 頁">
                        @i
                    </a>
                </li>
            }
            
            <!-- 下一頁按鈕 -->
            <li class="page-item @(page >= totalPage ? "disabled" : "")">
                <a class="page-link pagination-link" 
                   href="#" 
                   data-page="@(page + 1)" 
                   aria-label="下一頁"
                   title="下一頁">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>
<script type="text/javascript">
    /**
     * 重導向到搜尋結果頁面
     * 收集搜尋參數並重導向到搜尋頁面
     * pageNumber - 頁碼（選填，預設為 1）
     */
    function redirectToSearchResults(pageNumber) {
        // 取得搜尋輸入框的值
        const queryElement = document.getElementById("searchQuery");
        if (!queryElement) {
            console.error('找不到搜尋輸入框');
            return;
        }
        
        const query = queryElement.value.trim();
        
        // 建構 URL 查詢參數
        const params = new URLSearchParams();
        
        // 關鍵字參數（選填）
        if (query) {
            params.append('keyword', query);
        }
        
        // 頁碼參數（選填，未提供時使用預設值）
        if (pageNumber) {
            params.append('page', pageNumber);
        }
        
        // 重導向到搜尋頁面
        window.location.href = 'home?' + params.toString();
    }

    /**
     * DOM 載入完成後初始化事件監聽器
     */
    document.addEventListener('DOMContentLoaded', function() {
        // 為所有分頁連結添加點擊事件
        const paginationLinks = document.querySelectorAll('.pagination-link');
        paginationLinks.forEach(function(link) {
            link.addEventListener('click', function(e) {
                e.preventDefault(); // 阻止預設的錨點跳轉行為
                
                const pageNumber = this.getAttribute('data-page');
                
                // 確保頁碼有效後才執行重導向
                if (pageNumber && pageNumber > 0) {
                    redirectToSearchResults(pageNumber);
                }
            });
        });

        // 為搜尋輸入框添加 Enter 鍵事件監聽器
        const searchInput = document.getElementById("searchQuery");
        if (searchInput) {
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    redirectToSearchResults();
                }
            });
        }
    });
</script>